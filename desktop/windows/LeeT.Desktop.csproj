<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.8.5</Version>
    <Company>LEE T</Company>
    <Product>LEE T Warehouse</Product>
    <AssemblyTitle>LEE T Warehouse</AssemblyTitle>
    <Description>LEE T Warehouse</Description>
    <ApplicationIcon>../../public/brand/lee-t.ico</ApplicationIcon>
