  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <Resource Include="../../public/brand/lee-t-logo.jpg" Link="Brand/lee-t-logo.jpg" />
    <Resource Include="../../public/brand/lee-t.ico" Link="Brand/lee-t.ico" />
  </ItemGroup>
</Project>
