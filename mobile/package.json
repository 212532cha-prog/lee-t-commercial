{
  "name": "lee-t-mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app.mjs --bundle --outfile=dist/app.js --format=esm && node -e \"require('node:fs').copyFileSync('index.html','dist/index.html')\"",
    "android:prepare": "npm run build && node prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/inappbrowser": "4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2"
  }
}
